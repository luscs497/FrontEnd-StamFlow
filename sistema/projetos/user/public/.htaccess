# Página 404 customizada
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob: https://cdn.stamflow.com.br; connect-src 'self' https://api.stamflow.com.br https://cdn.jsdelivr.net; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # O index.html NÃO pode ficar em cache sem revalidar. Ele é o único arquivo
  # de URL fixa que aponta para os bundles hasheados do Next: se o navegador
  # servir uma cópia velha, ela pede o CSS/JS antigo (que continua no servidor,
  # porque o mirror do deploy não apaga) junto com o /scripts/*.js NOVO, que
  # tem URL fixa e é sobrescrito a cada deploy. Esse meio-a-meio quebra a tela
  # de formas difíceis de diagnosticar.
  #
  # Sem Cache-Control o navegador aplica cache heurístico (~10% da idade do
  # arquivo), então um index.html de um mês atrás pode passar dias sem
  # revalidar. `no-cache` não proíbe guardar: obriga a revalidar, o que com
  # ETag/Last-Modified custa um 304 de poucos bytes.
  #
  # Os bundles de /_next/ têm hash no nome e os de /scripts/ são versionados
  # pelo ASSET_VERSION na query, então nenhum dos dois precisa de regra aqui.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Q2 — /_next/static tem hash no nome do arquivo: o conteudo de uma URL
  # NUNCA muda, entao revalidar e desperdicio puro. Sem cabecalho explicito o
  # navegador cai no cache heuristico e volta a bater no servidor a toa.
  # `immutable` diz que nem em reload manual precisa revalidar.
  #
  # Vale SO para /_next/static. Os arquivos de /scripts/ tem URL fixa e sao
  # sobrescritos a cada deploy — quem os versiona e o ASSET_VERSION na query,
  # e dar max-age longo a eles reintroduziria exatamente o bug de cache que a
  # regra do index.html acima existe para evitar.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" STAMFLOW_IMUTAVEL=1
    Header always set Cache-Control "public, max-age=31536000, immutable" env=STAMFLOW_IMUTAVEL
  </IfModule>

</IfModule>

# ---------------------------------------------------------------------------
# Q1 — Compressao de texto.
#
# Nao havia nenhuma diretiva de compressao aqui. Com ~400 KB de HTML (metade
# deles o payload de hidratacao do Next, que e texto repetido e comprime
# muito bem), ~100 KB de CSS e ~380 KB de scripts legados, e o maior ganho de
# rede por linha escrita do painel.
#
# Os dois blocos sao <IfModule>: onde o modulo nao existir, viram no-op em vez
# de derrubar o site com 500. O LiteSpeed da Hostinger interpreta as diretivas
# de mod_deflate.
#
# Binarios ja comprimidos (png/jpg/webp/woff2/zip) ficam de fora de proposito:
# recomprimi-los gasta CPU e costuma AUMENTAR o tamanho.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject

  # Proxies precisam variar a resposta pelo Accept-Encoding.
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding
  </IfModule>
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml application/rss+xml
</IfModule>
