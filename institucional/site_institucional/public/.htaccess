# Serve a página 404 customizada para qualquer rota não encontrada
ErrorDocument 404 /404.html

# Roteamento do Next.js export estático:
# URLs com trailing slash apontam para a pasta/index.html correspondente
Options -MultiViews
RewriteEngine On

# Se o arquivo/pasta existe, serve diretamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tenta /rota/index.html (trailing slash do Next)
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]
